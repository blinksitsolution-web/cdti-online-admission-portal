# KIMTECH Admission Portal — Environment Variables
# Copy this file to .env and fill in values (never commit .env to git)
#
# Prefer placing an actual .env file in the web root (blocked from public
# access via .htaccess) over Hostinger hPanel's env var UI — hPanel-set
# variables aren't guaranteed to reach PHP's getenv() on every plan/PHP-FPM
# config (this bit us with KIMTECH_SECRET_KEY: it silently never resolved
# in production, so encryption-at-rest for stored secrets was never actually
# active). The .env file loader (includes/env.php) is proven to work.

# ── Application ──────────────────────────────────────────────────
APP_ENV=production

# ── Encryption key for secrets (AES-256-GCM) ─────────────────────
# Generate with: php -r "echo base64_encode(random_bytes(32));"
KIMTECH_SECRET_KEY=

# ── Paystack ───────────────────────────────────────────────────────
# From dashboard.paystack.com → Settings → API Keys & Webhooks.
# No longer configurable via Admin → Settings — see README "Environment variables".
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Hubtel SMS ───────────────────────────────────────────────────────
# From developers.hubtel.com. No longer configurable via Admin → Settings.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=CDTI

# ── Database (production only — alternative to db_prod.php) ──────
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=your_database
# DB_USER=your_user
# DB_PASS=your_password

# ── Cron alert email ─────────────────────────────────────────────
# Receives an email if the SMS cron job crashes
CRON_ALERT_EMAIL=admin@yourdomain.com
