Options -Indexes

# ── Protect sensitive files ───────────────────────────────────────
<FilesMatch "^(seed\.php|\.env|setup\.php|db_prod\.php|\.env\.example)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Block direct access & Setup pretty URLs ───────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct access to sensitive folders
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^seeds/    - [F,L]
  RewriteRule ^migrations/ - [F,L]

  # Allow Paystack webhook through (no .php stripping for POST)
  RewriteRule ^paystack_webhook$ paystack_webhook.php [L]

  # Redirect GET requests to strip .php extension
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Internally forward extensionless URLs to .php files
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# ── Security Headers ─────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # CSP: fallback only. "setifempty" (NOT "always set") is critical here —
  # "always set" unconditionally overrides whatever PHP's header() already
  # sent, which silently discarded every page's per-request nonce'd CSP from
  # emitCspHeader() this whole time. "setifempty" only applies this static
  # policy to pages that never call emitCspHeader() at all.
  Header setifempty Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://js.paystack.co https://checkout.paystack.com https://code.jquery.com; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://paystack.com 'unsafe-inline'; img-src 'self' data: https://*.paystack.co; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://api.paystack.co https://standard.paystack.co; frame-src https://js.paystack.co https://checkout.paystack.com https://standard.paystack.co;"
</IfModule>

# ── Caching for static assets ────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/css   "access plus 1 week"
</IfModule>
